#!/usr/bin/env bash
# quota-accounts: register the Claude accounts claude-rotate can launch under.
#
#   quota-accounts add <name>      create ~/.claude-accounts/<name>, share the
#                                  primary's projects/plugins/skills/settings,
#                                  log that account in (browser), copy the MCP servers
#   quota-accounts add default     register ~/.claude itself
#   quota-accounts list            show accounts and their last reading
#   quota-accounts refresh         re-read email/org of every account from its login
#   quota-accounts probe [name]    one-line headless run per account so each writes its reading
#   quota-accounts sync-mcp [name] bring the account's MCP servers and switches in step
#                                  with the primary login's, or every account's (the
#                                  launcher does this before each launch)
#   quota-accounts remove <name>   forget it (keeps the directory)
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib.sh"

SHARED=(projects plugins skills commands agents settings.json CLAUDE.md keybindings.json)

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  -h|--help|'')
    usage
    [ "${1:-}" = "" ] && exit 2
    exit 0
    ;;
esac

require_node
mkdir -p "$BASE/usage"
[ -f "$REG" ] || printf '{ "version": 1, "accounts": {} }\n' >"$REG"

write_registry() { # write_registry <name> <dir> <status-json>
  node -e '
    const fs = require("fs");
    const [reg, name, dir, statusJson] = process.argv.slice(1);
    const r = JSON.parse(fs.readFileSync(reg, "utf8"));
    const s = statusJson ? JSON.parse(statusJson) : {};
    r.accounts[name] = {
      ...(r.accounts[name] || {}),
      configDir: dir,
      ...(s.email ? { email: s.email } : {}),
      ...(s.orgId ? { orgId: s.orgId } : {}),
      ...(s.orgName ? { orgName: s.orgName } : {}),
      ...(s.subscriptionType ? { subscriptionType: s.subscriptionType } : {}),
      enabled: true,
    };
    fs.writeFileSync(reg, JSON.stringify(r, null, 2) + "\n");
  ' "$REG" "$1" "$2" "${3:-}"
}

case "$1" in
  add)
    name="${2:?quota-accounts add <name>}"
    case "$name" in *[!a-zA-Z0-9_-]*) echo "name must be letters, digits, - or _" >&2; exit 2;; esac
    dir="$(config_dir_of "$name")"
    if [ "$name" != "default" ]; then
      mkdir -p "$dir"
      for item in "${SHARED[@]}"; do
        if [ -e "$PRIMARY/$item" ] && [ ! -e "$dir/$item" ]; then
          ln -s "$PRIMARY/$item" "$dir/$item"
        fi
      done
    fi
    if claude_as "$name" auth status >/dev/null 2>&1; then
      echo "'$name' is already logged in at $dir; keeping that login (run 'claude auth logout' there to change it)"
    else
      echo "Logging in for account '$name' (a browser window opens; pick the right claude.ai account)..."
      claude_as "$name" auth login
    fi
    status="$(claude_as "$name" auth status --json 2>/dev/null || echo '{}')"
    write_registry "$name" "$dir" "$status"
    echo "Registered '$name' -> $dir"
    node -e 'const s=JSON.parse(process.argv[1]); console.log("  " + [s.email, s.orgName, s.subscriptionType].filter(Boolean).join(" · "))' "$status"
    sync_mcp "$name" || echo "not every MCP change reached '$name'; run: quota-accounts sync-mcp $name" >&2
    ;;
  sync-mcp)
    names="${2:-}"
    [ -n "$names" ] || names="$(registry_names)"
    failed=0
    for name in $names; do
      if [ "$name" = "default" ]; then echo "default: the source of the copy, nothing to do"; continue; fi
      if [ ! -d "$(config_dir_of "$name")" ]; then
        echo "$name: no config dir; run quota-accounts add $name" >&2
        failed=1
        continue
      fi
      out="$(sync_mcp "$name")" || failed=1
      if [ -n "$out" ]; then printf '%s\n' "$out"; else echo "$name: MCP servers already in step"; fi
    done
    exit "$failed"
    ;;
  probe)
    names="${2:-}"
    [ -n "$names" ] || names="$(registry_names)"
    for name in $names; do
      printf 'probing %s… ' "$name"
      if probe_account "$name"; then echo "ok"; else echo "FAILED (not logged in?)"; fi
    done
    "$0" list
    ;;
  refresh)
    for name in $(node -e 'const r=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log(Object.keys(r.accounts).join(" "))' "$REG"); do
      dir="$(config_dir_of "$name")"
      status="$(claude_as "$name" auth status --json 2>/dev/null || echo '{}')"
      write_registry "$name" "$dir" "$status"
      node -e 'const s=JSON.parse(process.argv[2]); console.log(process.argv[1].padEnd(16) + (s.loggedIn ? [s.email, s.orgName, s.subscriptionType].filter(Boolean).join(" · ") : "NOT logged in"))' "$name" "$status"
    done
    ;;
  list)
    node -e '
      const fs = require("fs"), path = require("path");
      const base = process.argv[1];
      const r = JSON.parse(fs.readFileSync(path.join(base, "accounts.json"), "utf8"));
      const usage = {};
      const dir = path.join(base, "usage");
      if (fs.existsSync(dir)) for (const f of fs.readdirSync(dir)) if (f.endsWith(".json")) {
        try { const u = JSON.parse(fs.readFileSync(path.join(dir, f), "utf8")); usage[u.account] = u; } catch {}
      }
      for (const [name, a] of Object.entries(r.accounts)) {
        const u = usage[name];
        const windows = u ? Object.entries(u.windows).map(([k, w]) => {
          const reset = w.resetsAt && Date.parse(w.resetsAt) <= Date.now();
          return `${k}=${reset ? 0 : w.percentUsed}%`;
        }).join(" ") : "no reading";
        console.log(`${name.padEnd(16)} ${(a.email || "").padEnd(24)} ${(a.orgName || "").slice(0, 24).padEnd(24)} ${windows}${u ? "  (" + u.observedAt + ")" : ""}`);
      }
    ' "$BASE"
    ;;
  remove)
    name="${2:?quota-accounts remove <name>}"
    node -e '
      const fs = require("fs"); const [reg, name] = process.argv.slice(1);
      const r = JSON.parse(fs.readFileSync(reg, "utf8")); delete r.accounts[name];
      fs.writeFileSync(reg, JSON.stringify(r, null, 2) + "\n");
    ' "$REG" "$name"
    echo "Removed '$name' from the registry (directory kept)."
    ;;
  *)
    usage
    exit 2
    ;;
esac
