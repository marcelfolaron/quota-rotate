#!/usr/bin/env bash
# claude-rotate: run Claude Code under the account with the most headroom, and
# when the quota-rotate mod hands the session off, relaunch it under the next
# account with the same session resumed.
#
#   claude-rotate [--account NAME] [claude args...]
#   claude-rotate --resume            session picker, under the emptiest account
#   claude-rotate -r <id|name>        resume that session
#   claude-rotate --continue          most recent session in this directory
#
# Accounts live under ~/.claude-accounts/<name>/ (see quota-accounts). The
# account named "default" is ~/.claude itself.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$(cd "$HERE/.." && pwd)"
BASE="${QUOTA_ROTATE_BASE:-$HOME/.claude-accounts}"
SWITCH_AT="${QUOTA_ROTATE_SWITCH_AT:-95}"
CLAUDE="${CLAUDE_BIN:-claude}"
RESUME_PROMPT="${QUOTA_ROTATE_RESUME_PROMPT:-The account was switched because of a usage limit. Continue exactly where you left off.}"

account=""
if [ "${1:-}" = "--account" ]; then
  account="${2:?--account needs a name}"
  shift 2
fi

# A resume flag from the command line applies to the first launch only; after a
# handoff the session id comes from the handoff file. Everything else passes
# through to every launch.
first=()
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--continue) first+=("$1"); shift ;;
    --resume=*) first+=("$1"); shift ;;
    -r|--resume)
      first+=("$1"); shift
      if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then first+=("$1"); shift; fi ;;
    *) rest+=("$1"); shift ;;
  esac
done

if [ ! -f "$BASE/accounts.json" ]; then
  echo "claude-rotate: no accounts registered. Run: $HERE/quota-accounts add <name>" >&2
  exit 1
fi
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "claude-rotate: CLAUDE_CODE_OAUTH_TOKEN is set and would override every account; unsetting it for this run" >&2
  unset CLAUDE_CODE_OAUTH_TOKEN
fi
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  echo "claude-rotate: ANTHROPIC_API_KEY is set and outranks a subscription login; unsetting it for this run" >&2
  unset ANTHROPIC_API_KEY
fi

config_dir_of() {
  if [ "$1" = "default" ]; then printf '%s\n' "$HOME/.claude"; else printf '%s\n' "$BASE/$1"; fi
}

pick() { # pick [exclude]
  node --disable-warning=ExperimentalWarning "$HERE/pick.ts" "$BASE" "${1:-}" "$SWITCH_AT"
}

session=""
prompt=""
handoff="$BASE/handoff.$$.json"
trap 'rm -f "$handoff"' EXIT

while :; do
  if [ -z "$account" ]; then
    account="$(pick "" || true)"
    if [ -z "$account" ]; then
      echo "claude-rotate: no account to launch under" >&2
      exit 1
    fi
  fi
  dir="$(config_dir_of "$account")"
  if [ ! -d "$dir" ]; then
    echo "claude-rotate: $account has no config dir at $dir; run quota-accounts add $account" >&2
    exit 1
  fi
  rm -f "$handoff"

  echo "claude-rotate: launching as $account${session:+ (resuming $session)}" >&2
  args=()
  if [ -n "$session" ]; then
    args+=(--resume "$session")
  elif [ ${#first[@]} -gt 0 ]; then
    args+=("${first[@]}")
    first=()
  fi
  [ -n "$prompt" ] && args+=("$prompt")
  set +e
  CLAUDE_CONFIG_DIR="$dir" \
  QUOTA_ROTATE_ACCOUNT="$account" \
  QUOTA_ROTATE_HANDOFF="$handoff" \
  CLAUDE_CODE_PLUGIN_DIRS="$PLUGIN_DIR${CLAUDE_CODE_PLUGIN_DIRS:+:$CLAUDE_CODE_PLUGIN_DIRS}" \
    "$CLAUDE" "${args[@]}" "${rest[@]}"
  status=$?
  set -e

  if [ ! -f "$handoff" ]; then
    exit "$status"
  fi

  next="$(node -e 'const h=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log([h.to,h.sessionId,h.reason].join("\t"))' "$handoff")"
  IFS=$'\t' read -r to sid reason <<<"$next"
  rm -f "$handoff"
  if [ -z "$to" ] || [ -z "$sid" ]; then
    echo "claude-rotate: malformed handoff; stopping" >&2
    exit 1
  fi
  echo "claude-rotate: handoff $account -> $to ($reason)" >&2
  account="$to"
  session="$sid"
  if [ "$reason" = "rate_limit" ]; then prompt="$RESUME_PROMPT"; else prompt=""; fi
done
