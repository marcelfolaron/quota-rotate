#!/usr/bin/env bash
# claude-rotate: run Claude Code under the account with the most headroom, and
# when the quota-rotate mod hands the session off, relaunch it under the next
# account with the same session resumed.
#
#   claude-rotate [--account NAME] [claude args...]
#   claude-rotate --resume            session picker, under the emptiest account
#   claude-rotate -r <id|name>        resume that session
#   claude-rotate --continue          most recent session in this directory
#
# Accounts live under ~/.claude-accounts/<name>/ (see quota-accounts). The
# account named "default" is ~/.claude itself.
#
# Environment: QUOTA_ROTATE_SWITCH_AT (threshold for the picker, default 95),
# QUOTA_ROTATE_NO_PROBE=1 (skip probing accounts with no reading before the first
# pick), QUOTA_ROTATE_RESUME_PROMPT (what the relaunch sends after a rate limit),
# CLAUDE_BIN (the claude binary), QUOTA_ROTATE_BASE (the accounts directory).
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib.sh"

SWITCH_AT="${QUOTA_ROTATE_SWITCH_AT:-95}"
RESUME_PROMPT="${QUOTA_ROTATE_RESUME_PROMPT:-The account was switched because of a usage limit. Continue exactly where you left off.}"

case "${1:-}" in
  -h|--help)
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

require_node

account=""
if [ "${1:-}" = "--account" ]; then
  account="${2:?--account needs a name}"
  shift 2
fi

# A resume flag from the command line applies to the first launch only; after a
# handoff the session id comes from the handoff file. Everything else passes
# through to every launch.
first=()
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--continue) first+=("$1"); shift ;;
    --resume=*) first+=("$1"); shift ;;
    -r|--resume)
      first+=("$1"); shift
      if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then first+=("$1"); shift; fi ;;
    *) rest+=("$1"); shift ;;
  esac
done

if [ ! -f "$REG" ]; then
  echo "claude-rotate: no accounts registered. Run: quota-accounts add <name>" >&2
  exit 1
fi
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "claude-rotate: CLAUDE_CODE_OAUTH_TOKEN is set and would override every account; unsetting it for this run" >&2
  unset CLAUDE_CODE_OAUTH_TOKEN
fi
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  echo "claude-rotate: ANTHROPIC_API_KEY is set and outranks a subscription login; unsetting it for this run" >&2
  unset ANTHROPIC_API_KEY
fi

# A handoff file is named after the launcher that owns it and removed when that
# launcher exits; one left by a launcher that is gone (killed, machine rebooted)
# must not be read by anyone.
for stale in "$BASE"/handoff.*.json; do
  [ -e "$stale" ] || continue
  pid="${stale##*/handoff.}"
  pid="${pid%.json}"
  case "$pid" in *[!0-9]*|'') continue ;; esac
  if ! kill -0 "$pid" 2>/dev/null; then rm -f "$stale"; fi
done

pick() { # pick [exclude]
  node --disable-warning=ExperimentalWarning "$HERE/pick.ts" "$BASE" "${1:-}" "$SWITCH_AT"
}

session=""
prompt=""
handoff="$BASE/handoff.$$.json"
trap 'rm -f "$handoff"' EXIT

# An account with no reading would rank as empty. Before the first pick, give each
# such account one headless turn so its reading exists (about 5 s each, once ever).
if [ -z "$account" ] && [ "${QUOTA_ROTATE_NO_PROBE:-0}" != "1" ]; then
  unknown="$(node -e '
    const fs=require("fs"),path=require("path"); const base=process.argv[1];
    const r=JSON.parse(fs.readFileSync(path.join(base,"accounts.json"),"utf8"));
    const have=new Set(); const dir=path.join(base,"usage");
    if (fs.existsSync(dir)) for (const f of fs.readdirSync(dir)) if (f.endsWith(".json")) { try { const u=JSON.parse(fs.readFileSync(path.join(dir,f),"utf8")); if (Object.keys(u.windows||{}).length) have.add(u.account) } catch {} }
    console.log(Object.entries(r.accounts).filter(([n,a])=>a.enabled!==false && !have.has(n)).map(([n])=>n).join(" "))' "$BASE")"
  for name in $unknown; do
    echo "claude-rotate: no reading for $name yet, probing…" >&2
    probe_account "$name" || echo "claude-rotate: probe of $name failed (not logged in?)" >&2
  done
fi

# The mod loads from this folder only when it is not installed as a plugin; an
# installed copy loads in every account through the shared plugins/ directory.
load_env=()
plugin_dirs="$(plugin_dirs_for_child)"
if [ -n "$plugin_dirs" ]; then
  load_env=("CLAUDE_CODE_PLUGIN_DIRS=$plugin_dirs")
fi

while :; do
  if [ -z "$account" ]; then
    account="$(pick "" || true)"
    if [ -z "$account" ]; then
      echo "claude-rotate: no account to launch under" >&2
      exit 1
    fi
  fi
  dir="$(config_dir_of "$account")"
  if [ ! -d "$dir" ]; then
    echo "claude-rotate: $account has no config dir at $dir; run quota-accounts add $account" >&2
    exit 1
  fi
  # MCP servers live in each account's own .claude.json: bring the primary login's along.
  sync_mcp "$account" | sed 's/^/claude-rotate: /' >&2 ||
    echo "claude-rotate: not every MCP change reached $account; launching anyway" >&2
  rm -f "$handoff"

  echo "claude-rotate: launching as $account${session:+ (resuming $session)}" >&2
  args=()
  if [ -n "$session" ]; then
    args+=(--resume "$session")
  elif [ ${#first[@]} -gt 0 ]; then
    args+=(${first[@]+"${first[@]}"})
    first=()
  fi
  [ -n "$prompt" ] && args+=("$prompt")
  # "default" runs with CLAUDE_CONFIG_DIR unset: the Keychain entry is keyed to the
  # variable, and an explicit ~/.claude is a different entry from none.
  config_env=()
  if [ "$account" != "default" ]; then config_env=("CLAUDE_CONFIG_DIR=$dir"); fi
  set +e
  env -u CLAUDE_CONFIG_DIR -u CLAUDE_CODE_PLUGIN_DIRS ${config_env[@]+"${config_env[@]}"} ${load_env[@]+"${load_env[@]}"} \
    QUOTA_ROTATE_ACCOUNT="$account" \
    QUOTA_ROTATE_HANDOFF="$handoff" \
    "$CLAUDE" ${args[@]+"${args[@]}"} ${rest[@]+"${rest[@]}"}
  status=$?
  set -e

  if [ ! -f "$handoff" ]; then
    exit "$status"
  fi

  next="$(node -e 'const h=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log([h.to,h.sessionId,h.reason].join("\t"))' "$handoff")"
  IFS=$'\t' read -r to sid reason <<<"$next"
  rm -f "$handoff"
  if [ -z "$to" ] || [ -z "$sid" ]; then
    echo "claude-rotate: malformed handoff; stopping" >&2
    exit 1
  fi
  echo "claude-rotate: handoff $account -> $to ($reason)" >&2
  account="$to"
  session="$sid"
  if [ "$reason" = "rate_limit" ]; then prompt="$RESUME_PROMPT"; else prompt=""; fi
done
